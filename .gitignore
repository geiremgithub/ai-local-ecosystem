# Ignorer alt
*

# Behold git-filer
!.gitignore
!.github/
!.github/**

# Behold dokumenter
!dokumenter/
!dokumenter/**

# Behold Project html
!Project html/
!Project html/**

# Men ignorer lokale arkiver
Project html/SCRIPT/
Project html/bckup/

# Python virtual environments
venv/
.venv/

# Python cache
__pycache__/
*.pyc

# VS Code
.vscode/
tempCodeRunnerFile.*

# ChromaDB
chroma/
chroma_db/

# SQLite
*.sqlite3

# Loggfiler
*.log

# Midlertidige filer
*.tmp
*.bak

# Jupyter
.ipynb_checkpoints/

# Lokale arkiver
BACKUP/

# Midlertidige mapper
temp/
tmp/
scratch/